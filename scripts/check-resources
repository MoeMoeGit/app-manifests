#!/usr/bin/env python3
"""Validate public resource envelopes and reject unintended tracked paths."""
import argparse
import base64
import json
import re
import subprocess
from datetime import datetime
from pathlib import Path
ROOT = Path(__file__).resolve().parent.parent

def approved(path):
    return path in {'.gitignore', 'README.md', 'scripts/manage', 'scripts/publish', 'scripts/check-resources', 'schemas/manifest-v1.schema.json', 'schemas/resources-v1.schema.json', 'schemas/update-v1.schema.json', 'apps/harvest/sync-v1/README.md'} or bool(re.fullmatch(r'apps/[a-z0-9-]+/(manifest-v1|resources-v1|update-v1)\.json', path)) or bool(re.fullmatch(r'apps/harvest/sync-v1/devices/[0-9a-f-]{36}/[0-9]{12}\.json', path))

def validate(raw):
    def unique(pairs):
        result = {}
        for name, value in pairs:
            if name in result:
                raise ValueError('duplicate field')
            result[name] = value
        return result
    if len(raw) > 32768:
        raise ValueError('resource too large')
    doc = json.loads(raw, object_pairs_hook=unique)
    if set(doc) != {'version', 'revision', 'payload'} or type(doc['version']) is not int or doc['version'] != 1 or type(doc['revision']) is not int or doc['revision'] < 1 or doc['revision'] > 9007199254740991:
        raise ValueError('invalid envelope')
    if len(base64.b64decode(doc['payload'], validate=True)) < 28:
        raise ValueError('invalid payload')

def validate_update(path, raw):
    def unique(pairs):
        result = {}
        for name, value in pairs:
            if name in result:
                raise ValueError('duplicate field')
            result[name] = value
        return result
    if len(raw) > 16384:
        raise ValueError('update manifest too large')
    doc = json.loads(raw, object_pairs_hook=unique)
    expected = {'schema', 'revision', 'app', 'version', 'published_at', 'release_url'}
    if set(doc) != expected or doc['schema'] != 1:
        raise ValueError('invalid update manifest fields')
    if type(doc['revision']) is not int or doc['revision'] < 1 or doc['revision'] > 9007199254740991:
        raise ValueError('invalid update revision')
    app = Path(path).parts[-2]
    if doc['app'] != app or not re.fullmatch(r'[a-z0-9-]+', app):
        raise ValueError('update app/path mismatch')
    version = doc['version']
    if not isinstance(version, str) or not re.fullmatch(r'(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)', version):
        raise ValueError('invalid stable semantic version')
    if not isinstance(doc['published_at'], str) or not re.fullmatch(r'[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z', doc['published_at']):
        raise ValueError('invalid published_at')
    try:
        datetime.strptime(doc['published_at'], '%Y-%m-%dT%H:%M:%SZ')
    except ValueError as error:
        raise ValueError('invalid published_at') from error
    expected_url = f'https://github.com/vivalucas/{app}/releases/tag/v{version}'
    if doc['release_url'] != expected_url:
        raise ValueError('release URL/version mismatch')

def validate_harvest(path, raw):
    if len(raw) > 64 * 1024 * 1024:
        raise ValueError('harvest sync pack too large')
    doc = json.loads(raw)
    expected = {'version', 'device', 'sequence', 'occurred_at', 'kdf', 'salt', 'nonce', 'ciphertext', 'auth_tag'}
    if set(doc) != expected or doc['version'] != 1 or type(doc['sequence']) is not int or doc['sequence'] < 1 or type(doc['occurred_at']) is not int or doc['occurred_at'] < 0:
        raise ValueError('invalid harvest sync envelope')
    kdf = doc['kdf']
    if kdf != {'name': 'argon2id', 'memory': 65536, 'passes': 3, 'parallelism': 1, 'tagLength': 32}:
        raise ValueError('invalid harvest sync kdf')
    if not re.fullmatch(r'[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}', doc['device']):
        raise ValueError('invalid harvest device id')
    parts = path.split('/')
    if parts[-2] != doc['device'] or int(parts[-1][:-5]) != doc['sequence']:
        raise ValueError('harvest sync path mismatch')
    decoded = {name: base64.b64decode(doc[name], validate=True) for name in ('salt', 'nonce', 'ciphertext', 'auth_tag')}
    if len(decoded['salt']) != 16 or len(decoded['nonce']) != 12 or len(decoded['auth_tag']) != 16 or not decoded['ciphertext']:
        raise ValueError('invalid harvest encrypted fields')

def git(*args):
    return subprocess.check_output(['git', '-C', str(ROOT), *args])

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--published', action='store_true')
    args = parser.parse_args()
    staged = git('ls-files', '-z').decode().split('\0')
    head = git('ls-tree', '-r', '--name-only', '-z', 'HEAD').decode().split('\0') if args.published else []
    if any(path and not approved(path) for path in staged + head):
        raise ValueError('unexpected tracked path; review locally before publishing')
    for path in ROOT.glob('apps/*/resources-v1.json'):
        validate(path.read_bytes())
    for path in ROOT.glob('apps/*/update-v1.json'):
        validate_update(path.relative_to(ROOT).as_posix(), path.read_bytes())
    for path in ROOT.glob('apps/harvest/sync-v1/devices/*/*.json'):
        validate_harvest(path.relative_to(ROOT).as_posix(), path.read_bytes())
    for path in staged:
        if path.endswith('/resources-v1.json'):
            validate(git('show', ':' + path))
        if path.endswith('/update-v1.json'):
            validate_update(path, git('show', ':' + path))
        if re.fullmatch(r'apps/harvest/sync-v1/devices/[0-9a-f-]{36}/[0-9]{12}\.json', path):
            validate_harvest(path, git('show', ':' + path))
    for path in head:
        if path.endswith('/resources-v1.json'):
            validate(git('show', 'HEAD:' + path))
        if path.endswith('/update-v1.json'):
            validate_update(path, git('show', 'HEAD:' + path))
        if re.fullmatch(r'apps/harvest/sync-v1/devices/[0-9a-f-]{36}/[0-9]{12}\.json', path):
            validate_harvest(path, git('show', 'HEAD:' + path))
    print('public resources and tracked paths: valid')

if __name__ == '__main__':
    try:
        main()
    except Exception:
        raise SystemExit('Public resource validation failed. Review the local diff and tracked paths; no contents displayed.')
