{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Application manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "app", "updated_at", "devices"],
  "properties": {
    "schema": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "app": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "devices": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-F0-9]{64}$"
      },
      "additionalProperties": {
        "type": "string",
        "format": "date"
      }
    }
  }
}
